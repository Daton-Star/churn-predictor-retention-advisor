# Copy this file to .streamlit/secrets.toml for local development
# (that file is gitignored -- never commit real keys).
#
# On Streamlit Community Cloud: App settings -> Secrets -> paste the same
# key = "value" line instead of uploading this file.
#
# Get a free key at https://aistudio.google.com/app/apikey (no credit card
# required, generous free-tier daily quota).

GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional: override the default model (gemini-2.5-flash). Check
# https://aistudio.google.com/app/apikey for which models your free-tier
# key currently has access to if the default ever stops working.
# GEMINI_MODEL = "gemini-2.5-flash"
